---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import Disqus from "@components/Disqus.astro";
import TOC from "@components/Toc.astro";
import { SITE, LOCALE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings } = await post.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

// Ensure canonical URL always points to stable /posts/{post.slug}/ for local pages.
const primaryCanonicalURL = new URL(
  `/posts/${post.slug}/`,
  SITE.website
).toString();

let normalizedCanonicalURL = primaryCanonicalURL;
if (canonicalURL) {
  try {
    const resolvedCanonicalURL = new URL(canonicalURL, SITE.website);
    const siteOrigin = new URL(SITE.website).origin;
    normalizedCanonicalURL =
      resolvedCanonicalURL.origin === siteOrigin
        ? primaryCanonicalURL
        : resolvedCanonicalURL.toString();
  } catch {
    normalizedCanonicalURL = primaryCanonicalURL;
  }
}

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: normalizedCanonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};

const date = pubDatetime.toLocaleDateString(LOCALE.langTag, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout {...layoutProps}>
  <Header />

  <!-- <div class="progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill">
    <div class="progress-bar h-1 w-0 bg-skin-accent" id="myBar"></div>
  </div> -->

  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mb-2 mt-8 flex hover:opacity-75"
      onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <main id="main-content" data-pagefind-body>
    <h1
      transition:name={slugifyStr(title)}
      class="post-title"
      data-pagefind-meta={`date:${date}`}
    >
      {title}
    </h1>
    <Datetime
      pubDatetime={pubDatetime}
      modDatetime={modDatetime}
      size="lg"
      className="my-2"
    />
    {!!headings.length && <TOC headings={headings} />}
    <article id="article" role="article" class="prose mx-auto mt-8 max-w-3xl">
      <Content />
    </article>

    <ul class="my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
    </ul>

    <div class="mb-10 opacity-60" data-pagefind-ignore="all">
      <hr class="mb-5" />
      <p>作者 : {author}</p>
      <p>地址 : {Astro.url}</p>
      <p>来源 : {SITE.website}</p>
      <p>著作权归作者所有，转载请联系作者获得授权。</p>
    </div>

    <div
      class="flex flex-col-reverse items-center justify-between gap-6 sm:flex-row-reverse sm:items-end sm:gap-4"
      data-pagefind-ignore="all"
    >
      <button
        id="back-to-top"
        class="focus-outline whitespace-nowrap py-1 hover:opacity-75"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rotate-90">
          <path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path>
        </svg>
        <span>Back to Top</span>
      </button>

      <ShareLinks />
    </div>

    <Disqus />
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }
</style>

<script is:inline>
  /** Idempotent DOM enhancements for post pages */
  (function () {
    let initialized = false;
    let scrollHandler = null;

    function cleanup() {
      if (scrollHandler) {
        document.removeEventListener("scroll", scrollHandler);
        scrollHandler = null;
      }
      const progressBar = document.getElementById("myBar");
      progressBar?.closest(".progress-container")?.remove();
    }

    function init() {
      if (initialized) return;
      initialized = true;

      // Progress bar
      const progressContainer = document.createElement("div");
      progressContainer.className =
        "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";
      const progressBar = document.createElement("div");
      progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
      progressBar.id = "myBar";
      progressContainer.appendChild(progressBar);
      document.body.appendChild(progressContainer);

      // Scroll handler
      scrollHandler = function updateScrollProgress() {
        const winScroll =
          document.body.scrollTop || document.documentElement.scrollTop;
        const height =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const bar = document.getElementById("myBar");
        if (bar) bar.style.width = scrolled + "%";
      };
      document.addEventListener("scroll", scrollHandler);

      // Heading links
      const headings = document.querySelectorAll("h2, h3, h4, h5, h6");
      headings.forEach(heading => {
        if (heading.querySelector(".heading-link")) return;
        heading.classList.add("group");
        const link = document.createElement("a");
        link.innerText = "#";
        link.className = "heading-link hidden group-hover:inline-block ml-2";
        link.href = "#" + heading.id;
        link.setAttribute("aria-hidden", "true");
        heading.appendChild(link);
      });

      // Copy buttons
      const codeBlocks = document.querySelectorAll("pre");
      codeBlocks.forEach(codeBlock => {
        if (codeBlock.querySelector(".copy-code")) return;
        const wrapper = document.createElement("div");
        wrapper.style.position = "relative";
        const copyButton = document.createElement("button");
        copyButton.className =
          "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
        copyButton.innerText = "Copy";
        codeBlock.setAttribute("tabindex", "0");
        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);
        codeBlock.appendChild(copyButton);
        copyButton.addEventListener("click", async () => {
          const code = codeBlock.querySelector("code");
          const text = code?.innerText;
          await navigator.clipboard.writeText(text ?? "");
          copyButton.innerText = "Copied";
          setTimeout(() => {
            copyButton.innerText = "Copy";
          }, 700);
        });
      });

      // Back to top
      document.querySelector("#back-to-top")?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    init();
    document.addEventListener("astro:after-swap", () => {
      cleanup();
      initialized = false;
      init();
    });
  })();
</script>
